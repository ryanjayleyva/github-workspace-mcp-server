# ------------------------------------------------------------
# n8n GitHub Workspace MCP Server - credentials template
# Copy this file to .env and fill in your real values.
# NOTE: n8n does NOT read this file. Configure the actual
#       values in n8n's credential UI.
# ------------------------------------------------------------

# MCP trigger credential: httpBearerAuth
MCP_BEARER_AUTH_NAME=
MCP_BEARER_AUTH_TOKEN=

# GitHub credential: githubOAuth2Api
GITHUB_CREDENTIAL_NAME=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Workflow defaults (baked into the JSON)
GITHUB_DEFAULT_OWNER=
