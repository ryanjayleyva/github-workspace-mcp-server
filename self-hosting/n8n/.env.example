# ------------------------------------------------------------------
# Self-hosted n8n behind Caddy. Copy to .env and fill in.
# .env is gitignored. Never commit real values.
# ------------------------------------------------------------------

# Public hostname that resolves to this server (an A or AAAA record).
# Caddy requests a certificate for exactly this name.
N8N_DOMAIN=

# n8n's credential encryption key. Generate it once, before first start:
#
#   openssl rand -hex 32
#
# Back it up somewhere safe. If you change it or lose it, every stored
# credential becomes permanently undecryptable.
N8N_ENCRYPTION_KEY=

# Timezone for the container and the default for the Schedule Trigger.
TZ=Asia/Manila
GENERIC_TIMEZONE=Asia/Manila
